# Real email: copy this file to ".env" (next to docker-compose.yml) and fill it in.
# Without a .env file the emails are caught by Mailpit (http://localhost:8025) and nothing leaves your computer.
# After changing it run:  docker compose -p ecommerce-local up -d worker

# Example 1: Gmail (turn on 2-step verification, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.name@gmail.com
SMTP_PASS=the-16-letter-app-password
MAIL_FROM=your.name@gmail.com

# Example 2: Brevo (free account, verify the sender address first)
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   SMTP_USER=<your Brevo login>     SMTP_PASS=<your Brevo SMTP key>
